# Fund secrets for the local runner. install.sh copies this to ~/.fund-runner/secrets.env (chmod 600).
# Fill in the values there; never commit the filled-in file.
# GitHub Actions secrets cannot be read back: copy each value from the provider's dashboard.

# required
OPENROUTER_API_KEY=
FINNHUB_API_KEY=
HF_TOKEN=
# the Alpaca paper account used only by the fund
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# optional
POLYGON_API_KEY=
# Amendment 6 context archive: FRED release calendar
FRED_API_KEY=
# Amendment 6 context archive: name and contact email, e.g. Jane Doe jane@example.com (SEC fair-access rule)
SEC_USER_AGENT=
